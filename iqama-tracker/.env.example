# انسخي الملف ده باسم .env وعدلي القيم

PORT=3000
NODE_ENV=production
# على السيرفر: PostgreSQL. على جهازك احذفي السطر ده والبرنامج هيستخدم قاعدة بيانات مدمجة
DATABASE_URL=postgres://iqama:CHANGE_ME@127.0.0.1:5432/iqama

# مفتاح سري طويل وعشوائي، مثلا: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_HOURS=12

APP_TIMEZONE=Asia/Riyadh

# تنبيهات الإيميل (اختياري)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASS=
SMTP_FROM=alerts@example.com
# أكثر من إيميل مفصولين بفاصلة
ALERT_EMAILS=hr@example.com
# ساعة الإرسال اليومي بتوقيت السعودية
ALERT_HOUR=8

# مجلد حفظ المستندات المرفوعة والحد الأقصى لحجم الملف
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# ---------- تنبيهات SMS وواتساب (اختياري) ----------
# أرقام جوالات المسؤولين اللي يوصلهم الملخص اليومي، مفصولة بفاصلة (05xxxxxxxx أو +9665xxxxxxxx)
ALERT_PHONES=0500000000

# مزود الرسائل: unifonic أو taqnyat أو twilio أو webhook (اتركيه فارغ لإيقاف SMS)
SMS_PROVIDER=
# اسم المرسل المعتمد (Sender ID) من المزود، وفي Twilio رقم الإرسال
SMS_SENDER=
# Unifonic: من لوحة Unifonic > Applications > AppSid
UNIFONIC_APP_SID=
# تقنيات: من لوحة تقنيات > Developers > Bearer Token
TAQNYAT_TOKEN=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# webhook: أي رابط يستقبل JSON {channel, to: [...], message} (مثلا n8n أو Make)
SMS_WEBHOOK_URL=

# واتساب للأعمال (WhatsApp Cloud API من Meta) — من developers.facebook.com > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# اسم قالب رسالة معتمد من Meta فيه متغير واحد {{1}} (لازم قالب عشان الرسائل توصل في أي وقت)
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=ar
